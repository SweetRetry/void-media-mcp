{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": ["docs/rules/**", ".agents/skills/**"],
  "workspaces": {
    ".": {
      "entry": [],
      "ignoreDependencies": ["vite"]
    },
    "apps/web": {
      "entry": [
        "src/routes/**/*.{ts,tsx}",
        "db/schema.ts",
        "void.config.ts",
        "crons/*.ts",
        "scripts/*.mjs",
        "env.ts"
      ],
      "project": ["src/**/*.{ts,tsx,css}", "db/**/*.ts", "*.ts"],
      "ignoreDependencies": ["tailwindcss"],
      "vite": false
    },
    "packages/ui": {
      "entry": [
        "src/components/**/*.tsx",
        "src/lib/**/*.ts",
        "src/hooks/**/*.ts",
        "src/styles/*.css"
      ],
      "project": ["src/**/*.{ts,tsx,css}"]
    },
    "packages/typescript-config": {
      "entry": [],
      "project": []
    },
    "packages/model-providers": {
      "entry": ["test/**/*.ts"],
      "project": ["src/**/*.ts"]
    }
  }
}
